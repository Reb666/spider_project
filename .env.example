# 数据库连接
DATABASE_URL=postgresql+psycopg2://dangdang:dangdang@localhost:5433/dangdang_books

# Docker Compose PostgreSQL 变量
PG_USER=dangdang
PG_PASSWORD=dangdang
PG_DB=dangdang_books

# 爬虫模式 (true=Playwright 渲染, false=原生 HTTP)
DANGDANG_USE_PLAYWRIGHT=false

# 登录态持久化 (make login 会弹出浏览器手动登录，短信验证码方式)
# DANGDANG_PLAYWRIGHT_DATA_DIR=data/playwright_data  # 持久化目录，默认即可
